APP_NAME=DevOrbit AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://devorbit:devorbit@localhost:5432/devorbit
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_MODE=memory
S3_BUCKET=devorbit-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_TTL_SECONDS=900
LOCAL_STORAGE_PATH=.local-storage
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
MAX_DOCUMENT_BYTES=10485760
MAX_AGENT_INPUT_CHARS=20000
GUARDRAIL_BLOCK_INJECTION=true
REDACT_EMAILS=true
REDACT_PHONE_NUMBERS=true
REQUIRE_APPROVAL_FOR_INVOICES=true
INVOICE_APPROVAL_THRESHOLD_CENTS=100000
INVOICE_DUE_DAYS=14
DEFAULT_TAX_RATE=0.0
PAYMENT_WEBHOOK_SECRET=
LLM_DEFAULT_PROVIDER=local
LLM_DEFAULT_MODEL=local-hash-embedder
LLM_INPUT_PRICE_PER_MILLION_USD=0.0
LLM_OUTPUT_PRICE_PER_MILLION_USD=0.0
LLM_PROVIDER_PRICING={}
